        "%make_build sqlite3_analyzer",
        "%endif",
        "",
        "# Build sqldiff",
        "%if %{with sqldiff}",
        "%make_build sqldiff",
        "%endif",
        "",
        "%install",
        "mkdir -p ${RPM_BUILD_ROOT}%{tcl_sitearch}",
        "%make_install"
    ]
